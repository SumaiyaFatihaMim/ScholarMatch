# Replace the password with your PostgreSQL password; URL-encode special characters.
# Create scholarmatch and apply database/schema.sql before starting the app.
DATABASE_URL=postgresql://postgres:your-password@127.0.0.1:5432/scholarmatch

# Optional: AI CV parsing. If unset, the manual profile editor still works.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: increases the request allowance for OpenAlex research search.
OPENALEX_API_KEY=
